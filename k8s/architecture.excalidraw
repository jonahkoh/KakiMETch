   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 Argo CD only manages k8s/app; the Secret and images live outside Git.\n\u2022 After a code change: make k8s-images, then kubectl -n kakimetch rollout restart deploy.\n\u2022 Every service reads DATABASE_URL from the Secret and talks to Supabase directly.",
   "originalText": "\u2022 Argo CD only manages k8s/app; the Secret and images live outside Git.\n\u2022 After a code change: make k8s-images, then kubectl -n kakimetch rollout restart deploy.\n\u2022 Every service reads DATABASE_URL from the Secret and talks to Supabase directly.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
